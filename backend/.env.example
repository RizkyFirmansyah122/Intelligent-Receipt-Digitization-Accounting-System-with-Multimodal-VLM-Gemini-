# ==========================================
# Backend Environment Variables (.env.example)
# ==========================================

# 1. Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Model Gemini (default: gemini-flash-lite-latest)
GEMINI_MODEL=gemini-flash-lite-latest

# 3. Google Sheets & Drive IDs
SPREADSHEET_ID=your_google_spreadsheet_id_here
DRIVE_FOLDER_ID=your_google_drive_folder_id_or_url_here

# 4. Kredensial Service Account GCP
# - Untuk Development Lokal: arahkan ke file json lokal
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# - Untuk Production Cloud (Render / Koyeb):
# Masukkan string Base64 dari file credentials.json (misal: cat credentials.json | base64)
# GOOGLE_CREDENTIALS_BASE64=eyJuYW1lIjoiLi4uIn0=

# 5. Konfigurasi Domain CORS (Opsional jika ada domain kustom selain vercel.app)
# ALLOWED_ORIGINS=https://pelangi-frame.com,https://app.pelangiframe.com
